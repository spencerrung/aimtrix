{
  "name": "aimtrix",
  "private": true,
  "version": "0.3.0-rc.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "proof:push": "node scripts/push-architecture-proof.mjs",
    "proof:push-sw": "node scripts/push-service-worker-proof.mjs",
    "proof:scheduling": "node scripts/scheduling-feasibility-proof.mjs",
    "release:validate": "node scripts/validate-release-contract.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "test:matrix": "node tests/live-matrix/run.mjs",
    "test:matrix:endurance": "node scripts/run-endurance.mjs",
    "test:matrix:rtc": "node tests/live-matrix/group-rtc.mjs",
    "test:matrix:privacy": "node --test tests/live-matrix/report.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.33.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^42.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
